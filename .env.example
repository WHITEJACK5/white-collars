# REQUIRED — app will fail to boot if these are missing
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/white-collars?retryWrites=true&w=majority
SESSION_SECRET=generate-a-strong-random-string-at-least-32-chars

# Optional — defaults shown
NODE_ENV=development
PORT=3000

# Seed script — admin credentials (only for initial seeding, rotate after)
SEED_ADMIN_EMAIL=admin@whitecollars.example.com
SEED_ADMIN_PASSWORD=ChangeMeImmediately123!

# Email (for password reset / verification — configure when enabling email features)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@whitecollars.example.com

# Security — see middleware/security.js
# CSRF_SECRET=generate-another-strong-random-string
