<%- include('partials/header') %>
<%- include('partials/navbar') %>

<section class="hero" style="padding:32px 0 16px">
  <div class="container" style="max-width:900px;text-align:left">
    <a href="/jobs" class="btn btn-ghost btn-sm" style="margin-bottom:12px">← Back to Jobs</a>
    <span class="badge badge-neon"><%= job.category %></span>
    <h1 style="font-size:36px;margin-top:10px"><%= job.title %></h1>
    <p style="margin-top:8px"><span class="badge badge-black"><%= job.company %></span> <span style="margin-left:8px;color:#3A3A3A"><%= job.location %> • <%= job.locationType %> • <%= job.employmentType %> • <%= job.experienceLevel %></span> • <span class="badge badge-white"><%= job.views %> views</span></p>
  </div>
</section>

<section class="section" style="padding-top:0">
  <div class="container" style="max-width:900px">
    <div class="grid3" style="grid-template-columns:1.2fr .8fr;gap:18px;align-items:start">
      <div class="card" style="padding:22px">
        <h3 style="font-size:14px;letter-spacing:.08em;text-transform:uppercase;color:#111">About the role</h3>
        <p style="color:#3A3A3A;line-height:1.7;margin-top:8px"><%= job.description %></p>

        <% if (job.skills && job.skills.length > 0) { %>
          <h3 style="font-size:12px;letter-spacing:.08em;text-transform:uppercase;margin-top:18px">Skills</h3>
          <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:8px">
            <% job.skills.forEach(skill => { %>
              <span class="badge badge-white"><%= skill %></span>
            <% }) %>
          </div>
        <% } %>

        <% if (job.requirements && job.requirements.length > 0) { %>
          <h3 style="font-size:12px;letter-spacing:.08em;text-transform:uppercase;margin-top:18px">Requirements</h3>
          <ul style="margin-top:8px;padding-left:18px;color:#3A3A3A;font-size:14px;line-height:1.7">
            <% job.requirements.forEach(r => { %><li><%= r %></li><% }) %>
          </ul>
        <% } %>

        <% if (job.responsibilities && job.responsibilities.length > 0) { %>
          <h3 style="font-size:12px;letter-spacing:.08em;text-transform:uppercase;margin-top:18px">Responsibilities</h3>
          <ul style="margin-top:8px;padding-left:18px;color:#3A3A3A;font-size:14px;line-height:1.7">
            <% job.responsibilities.forEach(r => { %><li><%= r %></li><% }) %>
          </ul>
        <% } %>

        <div style="display:flex;gap:10px;margin-top:18px;flex-wrap:wrap">
          <a href="/jobs" class="btn btn-ghost">Back to Jobs</a>
          <% if (user && job.postedBy && String(job.postedBy._id || job.postedBy) === String(user.id)) { %>
            <a href="/jobs/<%= job._id %>/edit" class="btn btn-dark">Edit Posting</a>
            <a href="/employer/jobs/<%= job._id %>/applicants" class="btn btn-primary">View Applicants (<%= job.applicants ? job.applicants.length : 0 %>)</a>
          <% } %>
        </div>
      </div>

      <div class="card" style="padding:22px;position:sticky;top:86px">
        <% if (user && job.postedBy && String(job.postedBy._id || job.postedBy) === String(user.id)) { %>
          <h3 style="font-size:14px">You posted this job</h3>
          <p style="color:#666;font-size:13px;margin-top:6px">Manage applicants or edit the posting.</p>
          <a href="/employer/dashboard" class="btn btn-primary" style="width:100%;justify-content:center;margin-top:12px">Go to Dashboard →</a>
        <% } else if (user) { %>
          <h3 style="font-size:14px">One-Click Apply</h3>
          <p style="color:#666;font-size:12px;margin-top:6px">Your saved profile will be submitted. Video will be mandatory only if employer requires it.</p>
          <form action="/jobs/<%= job._id %>/apply" method="POST" enctype="multipart/form-data" style="display:grid;gap:12px;margin-top:12px">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="field">
              <label>Cover Letter (optional)</label>
              <textarea name="coverLetter" rows="3" maxlength="2000" placeholder="Why are you a great fit?"></textarea>
            </div>
            <div class="field">
              <label>Resume (PDF/DOC, 5MB)</label>
              <input type="file" name="resume" accept=".pdf,.doc,.docx">
            </div>
            <div class="field">
              <label>Intro Video (optional, MP4/MOV/WebM, 50MB)</label>
              <input type="file" name="video" accept=".mp4,.mov,.webm,.mkv">
              <div style="font-size:11px;color:#666;margin-top:4px">Will be mandatory only for select roles.</div>
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center">Submit Application →</button>
          </form>
        <% } else { %>
          <h3 style="font-size:14px">Ready to apply?</h3>
          <p style="color:#666;font-size:13px;margin-top:6px">Sign in to one-click apply with your vault.</p>
          <a href="/auth/signin" class="btn btn-primary" style="width:100%;justify-content:center;margin-top:12px">Sign In to Apply →</a>
          <a href="/auth/signup" class="btn btn-ghost" style="width:100%;justify-content:center;margin-top:8px">Create Account</a>
        <% } %>
        <div style="margin-top:12px;padding:10px;background:var(--grid-white);border:1px solid #E5E7EB;border-radius:12px;font-size:12px;color:#666;text-align:center">
          <span class="badge badge-white">Secure</span> <span class="badge badge-white">GDPR Ready</span> <span class="badge badge-white">Encrypted</span>
        </div>
      </div>
    </div>

    <% if (relatedJobs && relatedJobs.length > 0) { %>
      <div style="margin-top:28px">
        <h3 style="font-size:14px;letter-spacing:.08em;text-transform:uppercase;text-align:center">Related Jobs</h3>
        <div class="jobs-grid" style="margin-top:14px">
          <% relatedJobs.forEach(j => { %>
            <a href="/jobs/<%= j._id %>" class="job-card" style="display:block">
              <h3><%= j.title %></h3>
              <div class="job-company"><%= j.company %></div>
              <div class="job-location"><%= j.location %></div>
              <span class="badge badge-neon" style="margin-top:8px">View →</span>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
