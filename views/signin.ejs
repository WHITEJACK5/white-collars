<%- include('partials/header') %>

<div class="auth-page">
  <div class="auth-container">
    <h1>Welcome back</h1>
    <p>Log in to WHITE COLLARS — Grid White • Black • Neon Green • Secure</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="error-message"><%= error %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="success-message"><%= success %></div>
    <% } %>

    <form action="/auth/signin" method="POST" style="display:grid;gap:12px;text-align:left">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label>Email Address *</label>
        <input type="email" name="email" required placeholder="you@whitecollars.com" autocomplete="email">
      </div>
      <div class="field">
        <label>Password *</label>
        <div style="position:relative">
          <input type="password" name="password" required placeholder="••••••••" minlength="8" autocomplete="current-password">
        </div>
        <div style="display:flex;justify-content:space-between;margin-top:6px">
          <span style="font-size:11px;color:#666">Min 8 chars</span>
          <a href="/auth/forgot-password" style="font-size:11px;color:var(--black);font-weight:700;text-decoration:underline">Forgot?</a>
        </div>
      </div>
      <div class="field">
        <label>Account Type *</label>
        <select name="role" required>
          <option value="jobseeker">Job Seeker</option>
          <option value="employer">Employer / Recruiter</option>
        </select>
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center">Continue →</button>
    </form>

    <div style="text-align:center;margin-top:14px;font-size:13px;color:#666">
      Don’t have an account? <a href="/auth/signup" style="color:var(--black);font-weight:800;text-decoration:underline">Register — Free</a>
    </div>
    <div style="text-align:center;margin-top:8px;font-size:11px;color:#666">🔒 Secure • Encrypted • GDPR Ready</div>
  </div>
</div>

<%- include('partials/footer') %>
