<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="page-header">
  <div class="page-header-content">
    <h1>Careers at WHITE COLLARS</h1>
    <p>Join our team and help us build the future of recruitment</p>
  </div>
</div>

<section class="content-section">
  <div class="container">
    <div class="grid grid-2">
      <div class="card">
        <h3>Why Join Us?</h3>
        <p style="color:#888; line-height:1.8; margin-top:1rem;">
          We're passionate about connecting people with opportunities. If you're looking for a challenging and rewarding environment, WHITE COLLARS might be the perfect fit.
        </p>
        <ul style="color:#888; line-height:2; margin-top:1rem; padding-left:1.5rem;">
          <li>🎯 Mission-driven culture</li>
          <li>💡 Innovative work environment</li>
          <li>📈 Career growth opportunities</li>
          <li>🏢 Flexible work arrangements</li>
          <li>💰 Competitive compensation</li>
        </ul>
        <a href="/contact" class="btn-outline" style="margin-top:2rem;">Get in Touch</a>
      </div>
      <div class="card">
        <h3>Open Positions</h3>
        <p style="color:#888; line-height:1.8; margin-top:1rem;">
          We're currently looking for talented individuals to join our team. Check back soon for new openings or contact us to discuss opportunities.
        </p>
        <div style="margin-top:1.5rem;">
          <div class="job-card">
            <h3>Engineering</h3>
            <div class="job-company">Technical Team</div>
            <p style="color:#666; font-size:0.9rem;">Backend, Frontend, DevOps, and more</p>
          </div>
          <div class="job-card" style="margin-top:1rem;">
            <h3>Marketing</h3>
            <div class="job-company">Growth Team</div>
            <p style="color:#666; font-size:0.9rem;">Content, SEO, Social Media, and more</p>
          </div>
          <div class="job-card" style="margin-top:1rem;">
            <h3>Support</h3>
            <div class="job-company">Customer Success</div>
            <p style="color:#666; font-size:0.9rem;">Help desk, community management, and more</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>