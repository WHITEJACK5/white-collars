<%- include('partials/header') %>
<%- include('partials/navbar') %>

<section class="hero" style="padding:32px 0 16px">
  <div class="container" style="text-align:center;max-width:760px">
    <span class="badge badge-neon">We’d love to hear from you</span>
    <h1 style="font-size:42px;margin-top:10px">Contact <span class="neon">Us</span></h1>
    <p style="margin:8px auto 0">Get in touch with our team — we’ll get back within 24 hours.</p>
  </div>
</section>

<section class="section" style="padding-top:0">
  <div class="container">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:18px;align-items:start">
      <div class="card">
        <h3 style="font-size:14px;letter-spacing:.08em;text-transform:uppercase">Send a Message</h3>
        <% if (typeof error !== 'undefined' && error) { %><div class="error-message"><%= error %></div><% } %>
        <% if (typeof success !== 'undefined' && success) { %><div class="success-message"><%= success %></div><% } %>
        <form action="/contact" method="POST" style="display:grid;gap:12px;margin-top:12px">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field"><label>Full Name *</label><input type="text" name="name" required placeholder="John Doe"></div>
          <div class="field"><label>Email Address *</label><input type="email" name="email" required placeholder="you@whitecollars.com"></div>
          <div class="field"><label>Subject *</label>
            <select name="subject" required>
              <option value="">Select a topic…</option>
              <option value="general">General Inquiry</option>
              <option value="support">Technical Support</option>
              <option value="jobs">Job Posting Issues</option>
              <option value="account">Account Help</option>
              <option value="partnership">Partnership</option>
              <option value="feedback">Feedback</option>
            </select>
          </div>
          <div class="field"><label>Message *</label><textarea name="message" rows="4" required placeholder="How can we help?" minlength="10"></textarea></div>
          <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center">Send Message →</button>
        </form>
      </div>

      <div class="card card-dark" style="padding:22px">
        <h3 style="font-size:14px;letter-spacing:.08em;text-transform:uppercase;color:var(--neon)">Get in Touch</h3>
        <div style="display:grid;gap:14px;margin-top:14px">
          <div style="display:flex;gap:12px;align-items:start">
            <div class="feature-ico" style="width:36px;height:36px;font-size:14px">✉</div>
            <div><strong style="font-size:13px">Email</strong><div style="font-size:13px;color:#AAA">support@whitecollars.com<br>careers@whitecollars.com</div></div>
          </div>
          <div style="display:flex;gap:12px;align-items:start">
            <div class="feature-ico" style="width:36px;height:36px;font-size:14px">☎</div>
            <div><strong style="font-size:13px">Phone</strong><div style="font-size:13px;color:#AAA">+1 (555) 123-4567<br>Mon-Fri, 9AM-6PM EST</div></div>
          </div>
          <div style="display:flex;gap:12px;align-items:start">
            <div class="feature-ico" style="width:36px;height:36px;font-size:14px">⌖</div>
            <div><strong style="font-size:13px">Office</strong><div style="font-size:13px;color:#AAA">123 Business Ave, Suite 500<br>New York, NY 10001</div></div>
          </div>
        </div>
        <a href="/" class="btn btn-ghost" style="width:100%;justify-content:center;margin-top:16px;background:white">← Back to Home</a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
