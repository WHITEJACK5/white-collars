<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="page-header">
  <div class="page-header-content">
    <h1>Contact Us</h1>
    <p>We'd love to hear from you. Get in touch with our team!</p>
  </div>
</div>

<section class="content-section">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-form-section">
        <h2>Send a Message</h2>

        <% if (error) { %>
          <div class="error-message"><%= error %></div>
        <% } %>

        <% if (success) { %>
          <div class="success-message"><%= success %></div>
        <% } %>

        <form action="/contact" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="form-group">
            <label for="name">Full Name</label>
            <input type="text" id="name" name="name" required placeholder="John Doe">
          </div>
          <div class="form-group">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" required placeholder="you@example.com">
          </div>
          <div class="form-group">
            <label for="subject">Subject</label>
            <select id="subject" name="subject" required>
              <option value="">Select a topic...</option>
              <option value="general">General Inquiry</option>
              <option value="support">Technical Support</option>
              <option value="jobs">Job Posting Issues</option>
              <option value="account">Account Help</option>
              <option value="partnership">Partnership</option>
              <option value="feedback">Feedback</option>
            </select>
          </div>
          <div class="form-group">
            <label for="message">Message</label>
            <textarea id="message" name="message" required placeholder="Tell us how we can help..." minlength="10"></textarea>
          </div>
          <button type="submit" class="btn">Send Message</button>
        </form>
      </div>

      <div class="contact-info-section">
        <h2>Get in Touch</h2>
        <div class="contact-info-item">
          <span class="contact-icon">📧</span>
          <div class="contact-info-details">
            <h3>Email</h3>
            <p>support@whitecollars.com<br>careers@whitecollars.com</p>
          </div>
        </div>
        <div class="contact-info-item">
          <span class="contact-icon">📞</span>
          <div class="contact-info-details">
            <h3>Phone</h3>
            <p>+1 (555) 123-4567<br>Mon-Fri, 9AM - 6PM EST</p>
          </div>
        </div>
        <div class="contact-info-item">
          <span class="contact-icon">📍</span>
          <div class="contact-info-details">
            <h3>Office</h3>
            <p>123 Business Avenue<br>Suite 500<br>New York, NY 10001</p>
          </div>
        </div>
        <div class="contact-info-item">
          <span class="contact-icon">⏰</span>
          <div class="contact-info-details">
            <h3>Hours</h3>
            <p>Mon-Fri: 9AM - 6PM<br>Sat: 10AM - 4PM<br>Sun: Closed</p>
          </div>
        </div>
        <div style="margin-top:1rem;">
          <h3 style="color:#39FF14; margin-bottom:0.8rem; font-size:1.1rem;">Follow Us</h3>
          <div class="social-links">
            <a href="#" title="LinkedIn">in</a>
            <a href="#" title="Twitter">x</a>
            <a href="#" title="Facebook">f</a>
            <a href="#" title="Instagram">IG</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>