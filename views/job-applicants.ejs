<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="page-header">
  <div class="page-header-content">
    <h1><%= job.title %> — Applicants</h1>
    <p><%= job.company %> • <%= job.location %></p>
  </div>
</div>

<section class="content-section">
  <div class="container">
    <a href="/employer/dashboard" class="btn-outline btn-sm" style="margin-bottom:1.5rem;">← Back to Dashboard</a>

    <% if (!job.applicants || job.applicants.length===0) { %>
      <div class="card" style="text-align:center; padding:3rem;">
        <h3 style="border:none;">No applicants yet</h3>
        <p class="text-muted">Share the posting to reach more candidates.</p>
      </div>
    <% } else { %>
      <div class="grid grid-2">
        <% job.applicants.forEach(app => { %>
          <div class="card">
            <h3><%= app.user ? app.user.name : 'Unknown' %></h3>
            <div class="job-company"><%= app.user ? app.user.email : '' %> • <%= app.user ? app.user.userType : '' %></div>
            <div class="job-location">Applied: <%= new Date(app.appliedAt).toLocaleString() %> • Status: <span class="category-count"><%= app.status %></span></div>
            <% if (app.resume) { %>
              <div style="margin:0.8rem 0;"><a href="<%= app.resume %>" target="_blank" class="text-green">View Resume</a></div>
            <% } %>
            <% if (app.coverLetter) { %>
              <p class="text-muted" style="font-size:0.9rem; margin:0.5rem 0; white-space:pre-wrap;"><%= app.coverLetter %></p>
            <% } %>

            <form action="/employer/jobs/<%= job._id %>/applicants/<%= app._id %>/status" method="POST" style="margin-top:1rem; display:flex; gap:0.5rem; flex-wrap:wrap; align-items:center;">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <select name="status" class="form-group" style="flex:1; min-width:140px; padding:0.6rem;">
                <option value="pending" <%= app.status==='pending'?'selected':'' %>>pending</option>
                <option value="reviewed" <%= app.status==='reviewed'?'selected':'' %>>reviewed</option>
                <option value="shortlisted" <%= app.status==='shortlisted'?'selected':'' %>>shortlisted</option>
                <option value="rejected" <%= app.status==='rejected'?'selected':'' %>>rejected</option>
                <option value="accepted" <%= app.status==='accepted'?'selected':'' %>>accepted</option>
              </select>
              <input name="note" placeholder="note (optional)" style="flex:1; padding:0.6rem; background:#111; border:1px solid #333; color:#e0e0e0; border-radius:4px;">
              <button type="submit" class="btn btn-sm">Update</button>
            </form>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
