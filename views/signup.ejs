<%- include('partials/header') %>

<div class="auth-page">
  <div class="auth-container">
    <h1>Sign Up</h1>
    <p>Join WHITE COLLARS today</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="error-message"><%= error %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="success-message"><%= success %></div>
    <% } %>

    <form action="/auth/signup" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label for="name">Full Name</label>
        <input type="text" id="name" name="name" required placeholder="John Doe">
      </div>
      <div class="form-group">
        <label for="email">Email Address</label>
        <input type="email" id="email" name="email" required placeholder="you@example.com">
      </div>
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required placeholder="Create a strong password" minlength="8">
        <small class="text-muted" style="font-size:0.8rem;">Min 8 chars, must include uppercase, lowercase, number, and symbol</small>
      </div>
      <div class="form-group">
        <label for="userType">I am a:</label>
        <select id="userType" name="userType" required>
          <option value="">Select your role...</option>
          <option value="jobseeker">Job Seeker</option>
          <option value="employer">Employer / Recruiter</option>
        </select>
      </div>
      <button type="submit" class="btn">Create Account</button>
    </form>

    <p class="auth-footer" style="margin-top:1.5rem;">
      Already have an account? <a href="/auth/signin">Sign In</a>
    </p>
  </div>
</div>

<%- include('partials/footer') %>
