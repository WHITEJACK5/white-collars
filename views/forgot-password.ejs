<%- include('partials/header') %>

<div class="auth-page">
  <div class="auth-container">
    <h1>Forgot password</h1>
    <p>Enter your email to receive a reset link</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="error-message"><%= error %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="success-message"><%= success %></div>
    <% } %>

    <form action="/auth/forgot-password" method="POST" style="display:grid;gap:12px;text-align:left">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label>Email Address *</label>
        <input type="email" name="email" required placeholder="you@whitecollars.com">
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center">Send Reset Link →</button>
    </form>

    <div style="text-align:center;margin-top:14px;font-size:13px;color:#666">
      Remembered? <a href="/auth/signin" style="color:var(--black);font-weight:800;text-decoration:underline">Log In</a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
