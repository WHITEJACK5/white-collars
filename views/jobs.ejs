<%- include('partials/header') %>
<%- include('partials/navbar') %>

<section class="hero" style="padding:32px 0 16px">
  <div class="container" style="text-align:center;max-width:760px">
    <span class="badge badge-neon">25K+ Jobs Monthly</span>
    <h1 style="font-size:42px;margin-top:10px">Browse <span class="neon">Jobs</span></h1>
    <p style="margin:8px auto 0">Explore diverse career opportunities across industries — filter by title, location, category.</p>
  </div>
</section>

<section class="section" style="padding-top:0">
  <div class="container">
    <form method="GET" action="/jobs" class="card" style="padding:16px;display:flex;gap:10px;flex-wrap:wrap;align-items:end;margin-bottom:18px">
      <div class="field" style="flex:1;min-width:160px">
        <label>Job title or keyword</label>
        <input type="text" name="title" placeholder="e.g. Software Engineer" value="<%= (filters && filters.title) || '' %>">
      </div>
      <div class="field" style="flex:1;min-width:140px">
        <label>Location</label>
        <input type="text" name="location" placeholder="e.g. Bengaluru" value="<%= (filters && filters.location) || '' %>">
      </div>
      <div class="field" style="min-width:160px">
        <label>Category</label>
        <select name="category">
          <option value="">All categories</option>
          <% (categories || []).forEach(cat => { %>
            <option value="<%= cat %>" <%= filters && filters.category===cat ? 'selected' : '' %>><%= cat %></option>
          <% }) %>
        </select>
      </div>
      <button type="submit" class="btn btn-primary">Search</button>
      <a href="/jobs" class="btn btn-ghost">Reset</a>
    </form>

    <div class="jobs-grid">
      <% jobs.forEach(job => { %>
        <div class="job-card">
          <h3><%= job.title %></h3>
          <div class="job-company"><%= job.company %></div>
          <div class="job-location"><%= job.location %> • <%= job.employmentType || 'Full-time' %></div>
          <div class="job-description"><%= job.description ? job.description.substring(0, 130) + '...' : '' %></div>
          <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px">
            <span class="badge badge-white"><%= job.category %></span>
            <span class="badge badge-white"><%= job.experienceLevel || 'Mid Level' %></span>
          </div>
          <div style="display:flex;gap:8px">
            <a href="/jobs/<%= job._id %>" class="btn btn-primary btn-sm" style="flex:1;justify-content:center">View Details →</a>
            <a href="/jobs/<%= job._id %>" class="btn btn-ghost btn-sm">Apply</a>
          </div>
        </div>
      <% }) %>
    </div>

    <% if (typeof pagination !== 'undefined' && pagination && pagination.totalPages > 1) { %>
      <div class="pagination">
        <% if (pagination.hasPrev) { %>
          <a href="?page=<%= pagination.page - 1 %>&limit=<%= pagination.limit %><%= filters && filters.title ? '&title='+encodeURIComponent(filters.title) : '' %><%= filters && filters.location ? '&location='+encodeURIComponent(filters.location) : '' %><%= filters && filters.category ? '&category='+encodeURIComponent(filters.category) : '' %>">← Prev</a>
        <% } %>
        <span class="badge badge-black">Page <%= pagination.page %> of <%= pagination.totalPages %> • <%= pagination.total %> jobs</span>
        <% if (pagination.hasNext) { %>
          <a href="?page=<%= pagination.page + 1 %>&limit=<%= pagination.limit %><%= filters && filters.title ? '&title='+encodeURIComponent(filters.title) : '' %><%= filters && filters.location ? '&location='+encodeURIComponent(filters.location) : '' %><%= filters && filters.category ? '&category='+encodeURIComponent(filters.category) : '' %>">Next →</a>
        <% } %>
      </div>
    <% } %>

    <% if (!jobs || jobs.length === 0) { %>
      <div class="card" style="text-align:center;padding:32px;max-width:560px;margin:18px auto 0">
        <h3>No jobs found</h3>
        <p style="color:#666;font-size:13px;margin-top:6px">Try adjusting filters or check back later.</p>
        <a href="/jobs" class="btn btn-dark" style="margin-top:12px">Clear filters</a>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
